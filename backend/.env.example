# ---------------------------------------------------------------------------
# AI Nutrition Coach Thailand - Backend environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
PUBLIC_LIFF_URL=https://liff.line.me/REPLACE_WITH_LIFF_ID
TZ=Asia/Bangkok
LOG_LEVEL=info

# --- Security ---
# 32+ char random string used for backend session JWT (LIFF -> API session)
SESSION_JWT_SECRET=
# Comma-separated list of allowed CORS origins (LIFF endpoint URL)
CORS_ALLOWED_ORIGINS=https://liff.line.me

# --- Database ---
# SQLite file path (mounted volume in Railway: /data/app.db)
DATABASE_URL=file:./data/app.db

# --- LINE Messaging API (the bot channel) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE Login channel (for LIFF) ---
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_COACH_PREMIUM=gpt-4o

# Per-user daily AI call budget (soft cap)
AI_DAILY_BUDGET_FREE=30
AI_DAILY_BUDGET_PREMIUM=200

# --- Stripe (international card payments) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PREMIUM_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# --- LINE Pay (local Thai payments) ---
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=
LINE_PAY_ENV=sandbox   # sandbox | production

# --- Object storage (food photos) ---
# At MVP we can store photos on Railway volume; switch to S3/B2 when scaling.
PHOTO_STORAGE_BACKEND=local   # local | s3
PHOTO_LOCAL_DIR=./data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Feature flags ---
FEATURE_LINE_PAY=false
FEATURE_WEEKLY_REPORT=true
FEATURE_PREMIUM_COACH=true
