# ---------------------------------------------------------------------------
# AI Nutrition Coach Thailand - Backend environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
PUBLIC_LIFF_URL=https://liff.line.me/REPLACE_WITH_LIFF_ID
TZ=Asia/Bangkok
LOG_LEVEL=info

# --- Security ---
# 32+ char random string used for backend session JWT (LIFF -> API session)
SESSION_JWT_SECRET=
# Comma-separated list of allowed CORS origins (LIFF endpoint URL)
CORS_ALLOWED_ORIGINS=https://liff.line.me

# --- Database ---
# SQLite file path (mounted volume in Railway: /data/app.db)
DATABASE_URL=file:./data/app.db

# --- LINE Messaging API (the bot channel) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE Login channel (for LIFF) ---
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o
OPENAI_MODEL_COACH_PREMIUM=gpt-4o

# Per-user daily AI call budget (soft cap)
AI_DAILY_BUDGET_FREE=30
AI_DAILY_BUDGET_PREMIUM=200

# --- Stripe (international card payments — POSTPONED, code dormant) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://app.tinadiet.com/?upgraded=1
BILLING_CANCEL_URL=https://app.tinadiet.com/?upgrade_canceled=1

# --- Omise (PRIMARY payment provider — PromptPay + TrueMoney, manual renew) ---
# Get keys from dashboard.omise.co > Settings > Keys
# TEST mode: pkey_test_* / skey_test_*  |  LIVE mode: pkey_* / skey_* (after KYC)
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_API_BASE_URL=https://api.omise.co
OMISE_API_VERSION=2019-05-29
# Webhook HTTP Basic Auth (configure same user:pass in Omise dashboard > Settings > Webhooks)
# If empty, webhook accepts all requests (DEV ONLY — production MUST set these)
OMISE_WEBHOOK_BASIC_USER=
OMISE_WEBHOOK_BASIC_PASS=
# Price + grant settings (defaults: 150 THB → 30 days premium)
PAYMENT_AMOUNT_THB=150
PAYMENT_GRANT_DAYS=30
# Where TrueMoney redirects user after authorization
PAYMENT_RETURN_URL=https://app.tinadiet.com/premium?omise_return=1

# --- Object storage (food photos) ---
# At MVP we can store photos on Railway volume; switch to S3/B2 when scaling.
PHOTO_STORAGE_BACKEND=local   # local | s3
PHOTO_LOCAL_DIR=./data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=

# --- Feature flags ---
FEATURE_LINE_PAY=false
FEATURE_WEEKLY_REPORT=true
FEATURE_PREMIUM_COACH=true
