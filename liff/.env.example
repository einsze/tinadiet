# ---------------------------------------------------------------------------
# AI Nutrition Coach Thailand - LIFF (Vite) environment variables
# Only variables prefixed with VITE_ are exposed to the browser.
# Copy to `.env` for local dev. Production values set in Railway.
# ---------------------------------------------------------------------------

# LIFF ID issued by LINE Developers (LINE Login channel)
VITE_LIFF_ID=

# Backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# Default locale: th-TH | en-US
VITE_DEFAULT_LOCALE=th-TH

# Sentry (browser DSN, optional - separate project from backend)
VITE_SENTRY_DSN=

# Feature flags mirrored from backend (UI gating only - server is source of truth)
VITE_FEATURE_PHOTO_LOG=true
VITE_FEATURE_WEEKLY_REPORT=true
